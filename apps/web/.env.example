# mcp-lock developer platform — local environment template
# Copy to .env.local and fill in real values. Never commit real secrets.

# Public site URL (used for metadata, OG images, auth redirects, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (local SQLite file by default; Postgres URL accepted by some hosts)
MCP_LOCK_DATABASE_URL=file:./data/mcp-lock.db

# Artifact storage (local filesystem by default)
MCP_LOCK_STORAGE_DIR=./data/artifacts

# Hosted scan worker configuration (reserved; scans execute locally via CLI today)
MCP_LOCK_HOSTED_SCAN_WORKER_URL=

# App metadata
NEXT_PUBLIC_APP_NAME=mcp-lock
NEXT_PUBLIC_GITHUB_REPOSITORY_URL=https://github.com/Codexia-afk/mcp_lock
NEXT_PUBLIC_GITHUB_REPOSITORY=github.com/Codexia-afk/mcp_lock

# Feature flags
NEXT_PUBLIC_FEATURE_HOSTED_SCANNING=false
NEXT_PUBLIC_FEATURE_TEAMS=false
EOF
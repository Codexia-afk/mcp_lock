{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcp-lock:config:v1",
  "title": "mcp-lock scenario config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "image", "entrypoint", "protocolMode", "scenarios"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "image": {"type": "string", "pattern": "^(sha256:|[A-Za-z0-9][A-Za-z0-9._/:-]*@sha256:)[0-9a-f]{64}$"},
    "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "protocolMode": {"enum": ["modern", "legacy"]},
    "fixtureMounts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source", "target"], "properties": {"source": {"type": "string"}, "target": {"type": "string"}}}},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "tool", "arguments", "expectText"], "properties": {"name": {"type": "string", "minLength": 1}, "tool": {"type": "string", "minLength": 1}, "arguments": {"type": "object"}, "expectText": {"type": "string"}}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcp-lock:behavior-lock:v1",
  "title": "mcp-lock behavior evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "server", "protocol", "scenarioSuite", "environment", "observer", "observations", "evidenceDigest"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["imageDigest", "entrypoint"],
      "properties": {"imageDigest": {"$ref": "#/$defs/digest"}, "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "transport"],
      "properties": {"version": {"type": "string", "minLength": 1}, "transport": {"const": "stdio"}}
    },
    "scenarioSuite": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "fixtureDigest", "completed", "total"],
      "properties": {"digest": {"$ref": "#/$defs/digest"}, "fixtureDigest": {"$ref": "#/$defs/digest"}, "completed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 1}}
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["imageDigest", "kernel", "arch"],
      "properties": {"imageDigest": {"$ref": "#/$defs/digest"}, "kernel": {"type": "string", "minLength": 1}, "arch": {"type": "string", "minLength": 1}}
    },
    "observer": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "version", "status"],
      "properties": {"backend": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "lostEvents": {"type": ["integer", "null"], "minimum": 0}, "status": {"enum": ["complete", "incomplete"]}}
    },
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "evidenceDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "outcome", "scenario", "count"],
      "properties": {
        "kind": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1},
        "objectDigest": {"$ref": "#/$defs/digest"}, "outcome": {"type": "string", "minLength": 1},
        "scenario": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 1}
      },
      "if": {"properties": {"kind": {"const": "process.exec"}}},
      "then": {"required": ["objectDigest"]}
    }
  }
}
